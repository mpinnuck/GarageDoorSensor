  (text "Off board: Padors PDS-101 terminal block CON1." (at 191.77 109.22 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 22a71984-bdff-456e-99ba-5369bd2a7764))
  (text "4-core cable from J4 (JST PH plug) to PB, GND, FLASH and +24." (at 191.77 111.76 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 7b0655e4-da46-4ba3-a884-d39652951fc9))
  (text "Leave PE (photo beam) as it is." (at 191.77 114.3 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 3d9d2d4a-3d63-4e6e-8896-a0f17d259e76))
  (text "Opener control (Padors PDS-101). Connects to the main sheet by global labels." (at 30.48 40.64 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid ad10ede9-805f-4668-8f55-1152a464eb5e))
  (text "OPENER_TRIG = XIAO D2 (GPIO4): high pulse ~0.5 s = wall-button press (open / stop / close)." (at 30.48 43.18 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid f4cb5235-f642-4305-98c3-33e72d82eb8d))
  (text "OPENER_MOVING = XIAO D3 (GPIO5): LOW while the opener FLASH output is active (door moving)." (at 30.48 45.72 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 34c9a97c-e280-4b81-a754-bc4fc285b755))
  (text "Powered from the opener +24 V, so OPENER_GND = GND (not isolated). U3/U4 still give clean switching and level shifting." (at 30.48 48.26 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid c31b4d78-8894-42ae-89c3-cccbff4ab8e8))
  (text "U3 LED ~6 mA from 3.3 V via R7. R10 holds U3 off during boot/reset." (at 30.48 83.82 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 15ed398d-1b40-48b4-82a1-7c86f550f640))
  (text "U3 output (60 V, 0.5 A, either polarity) closes PB to opener GND." (at 30.48 86.36 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 79454968-3c1a-472d-90ec-2d31a5b602cc))
  (text "R8 sets ~4.8 mA from a 24 V FLASH output (0.11 W). D4 protects the LED against reverse voltage." (at 30.48 142.24 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 13d9390e-edc9-4e5d-a1ee-924d9cbe53b3))
  (text "Check FLASH to GND with a meter while the door runs; if FLASH pulses, firmware treats pulses as moving." (at 30.48 144.78 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 15a7c49c-6766-4d24-a8d6-ab9f60d26908))
